# Local backend environment. Copy to .env or export manually.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL is injected by Render (Postgres provider connection string).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=1

# Live providers. Use ROUTING_PROVIDER=mock / WEATHER_PROVIDER=mock for offline tests.
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com
ROUTING_PROVIDER=ors
WEATHER_PROVIDER=open_meteo
PROVIDER_HTTP_TIMEOUT=90
FORECAST_THROTTLE_RATE=60/min
